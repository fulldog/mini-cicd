# 复制为同目录 .env 后填写。不要把 .env 或仓库 Secrets 提交进 Git。
# openssl rand -hex 32

# Web UI 对外地址（无末尾斜杠），须与 Git OAuth 回调一致
WOODPECKER_HOST=http://CI宿主机IP:8000

WOODPECKER_HTTP_PORT=8000
WOODPECKER_GRPC_PORT=9000

# server 与 agent 共享
WOODPECKER_AGENT_SECRET=

# 开放注册；收紧时设 false，并用 WOODPECKER_ADMIN 指定 forge 用户名
WOODPECKER_OPEN=true
WOODPECKER_ADMIN=

# --- GitHub（默认）---
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# --- Gitea / Forgejo（启用时 WOODPECKER_GITHUB=false）---
WOODPECKER_GITEA=false
WOODPECKER_GITEA_URL=
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

WOODPECKER_HOST_AGENT_BIN=/usr/local/bin/woodpecker-agent
# agent 注册 ID 的落盘位置（宿主机路径）；目录不存在时每次重启都会新注册一个 agent
WOODPECKER_AGENT_CONFIG_FILE=/etc/woodpecker/agent.conf
WOODPECKER_BACKEND_LOCAL_TEMP_DIR=/var/tmp/woodpecker
WOODPECKER_AGENT_SERVER=127.0.0.1:9000

# 流水线若编 Go 模块可用；没有 Go 项目可忽略
GOPROXY=https://goproxy.cn,direct

# 跨流水线持久缓存（local backend 每次任务会换临时 HOME，不设这些就会每次重下模块/工具链）
WOODPECKER_CACHE_DIR=/var/cache/woodpecker
GOMODCACHE=/var/cache/woodpecker/go/mod
GOCACHE=/var/cache/woodpecker/go/build
NPM_CONFIG_CACHE=/var/cache/woodpecker/npm
PNPM_STORE_DIR=/var/cache/woodpecker/pnpm
XDG_CACHE_HOME=/var/cache/woodpecker/xdg
# auto：go.mod 比本机 go 新时下载 toolchain 并写入 GOMODCACHE（只下一次）
# local：禁止下载工具链，要求宿主机 go 版本满足 go.mod
GOTOOLCHAIN=auto

# nsenter 后 agent 的 PATH：放上本机已装的编译器与 rsync/ssh/curl
HOST_PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
